# Claude Codeローカル設定
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# ログ
error.log
*.log

# 音声・処理データ(サイズが大きいため除外)
# 注意: 以前は input/ output/ もまるごと除外していたが、中身はソースコードのみ
# (mic_input.py や output/web/app.js 等)でデータではなく、一度もgit管理されて
# いなかった。実際に録音データを置く場合は input/recordings/ のように
# サブディレクトリを切ってそこだけ除外すること。
test_audio/

# サードパーティ製バイナリ(公式サイトから入手可能)
tools/dfu-util/

# モデルキャッシュ
*.pt
*.bin
*.onnx

# Voskモデル(数十MB〜1GB、公式サイトから別途ダウンロードするため除外)
models/

# G2アプリ（g2app/）の部品置き場とビルド結果（npm install / npm run pack で作り直せる）
g2app/node_modules/
g2app/dist/
g2app/.env.local
g2app/.env.*.local
*.ehpk

# APIキー（公開リポジトリなので絶対に送らない）
local_secrets.py
